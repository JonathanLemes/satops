{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://satops.io/schemas/v1alpha1/BitcoinIntegration.json",
  "title": "Bitcoin Core integration",
  "description": "Connection to a Bitcoin Core regtest node through JSON-RPC and ZeroMQ.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "satops.io/v1alpha1"
    },
    "kind": {
      "const": "BitcoinIntegration"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
          "description": "Lowercase identifier"
        },
        "labels": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "maxLength": 63
          }
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentRef",
        "network",
        "rpc"
      ],
      "properties": {
        "environmentRef": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
          "description": "Environment slug"
        },
        "network": {
          "const": "regtest"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "rpc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "port",
            "secretRef"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "secretRef": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
              "description": "Lowercase identifier"
            },
            "wallet": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "zmq": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^tcp://[^\\s]+:[0-9]+$"
            }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reconcileInterval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m)$",
              "description": "Duration such as 500ms, 30s or 5m"
            },
            "timeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m)$",
              "description": "Duration such as 500ms, 30s or 5m"
            }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "backoff": {
              "enum": [
                "exponential",
                "fixed"
              ]
            }
          }
        }
      }
    }
  }
}
