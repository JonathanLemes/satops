{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://satops.io/schemas/v1alpha1/Experiment.json",
  "title": "Experiment scenario",
  "description": "Typed, whitelisted sequence of actions and assertions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "satops.io/v1alpha1"
    },
    "kind": {
      "const": "Experiment"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
          "description": "Lowercase identifier"
        },
        "labels": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "maxLength": 63
          }
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "steps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "guarantee": {
          "type": "string",
          "maxLength": 500
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-_]{0,62}$"
              },
              "action": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z_]+$"
              },
              "phase": {
                "enum": [
                  "prepare",
                  "run",
                  "verify",
                  "cleanup"
                ]
              },
              "params": {
                "type": "object",
                "maxProperties": 30
              },
              "timeout": {
                "type": "string",
                "pattern": "^[0-9]+(ms|s|m)$",
                "description": "Duration such as 500ms, 30s or 5m"
              },
              "maxAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        },
        "assertions": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z_]+$"
              },
              "timeout": {
                "type": "string",
                "pattern": "^[0-9]+(ms|s|m)$",
                "description": "Duration such as 500ms, 30s or 5m"
              }
            },
            "maxProperties": 12
          }
        }
      }
    }
  }
}
