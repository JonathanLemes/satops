{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://satops.io/schemas/v1alpha1/ReconciliationPolicy.json",
  "title": "Reconciliation policy",
  "description": "Sources, required sources and timing rules used by the reconciliation engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "satops.io/v1alpha1"
    },
    "kind": {
      "const": "ReconciliationPolicy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
          "description": "Lowercase identifier"
        },
        "labels": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "maxLength": 63
          }
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentRef"
      ],
      "properties": {
        "environmentRef": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
          "description": "Environment slug"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
            "description": "Lowercase identifier"
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "requiredSources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
            "description": "Lowercase identifier"
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "settlementDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "matching": {
          "const": "deterministic"
        }
      }
    }
  }
}
