{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://satops.io/schemas/v1alpha1/AlertPolicy.json",
  "title": "Alert policy",
  "description": "Events that raise alerts, cooldown and notification destinations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "satops.io/v1alpha1"
    },
    "kind": {
      "const": "AlertPolicy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
          "description": "Lowercase identifier"
        },
        "labels": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "maxLength": 63
          }
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentRef",
        "events"
      ],
      "properties": {
        "environmentRef": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
          "description": "Environment slug"
        },
        "enabled": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "node.disconnected",
              "integration.unavailable",
              "transaction.confirmation_delayed",
              "chain.reorganized",
              "reconciliation.discrepancy_detected",
              "reconciliation.completed",
              "reconciliation.incomplete",
              "experiment.finished",
              "ledger.invariant_violated",
              "node.diverged",
              "ledger.deposit_reversed"
            ]
          }
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "cooldown": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m)$",
          "description": "Duration such as 500ms, 30s or 5m"
        },
        "destinations": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "internal",
                  "webhook"
                ]
              },
              "integration": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
                "description": "Lowercase identifier"
              }
            }
          }
        }
      }
    }
  }
}
