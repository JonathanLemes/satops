{
  "uid": "satops-experiments",
  "title": "SatOps experiments",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "satops"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Experiment duration p50",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "satops-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, status) (rate(experiment_duration_seconds_bucket[1h])))",
          "legendFormat": "{{method}}{{queue}}{{status}}{{kind}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failed assertions",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "satops-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(experiment_assertions_failed_total[1h]))",
          "legendFormat": "{{method}}{{queue}}{{status}}{{kind}}"
        }
      ]
    }
  ]
}
